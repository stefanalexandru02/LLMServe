# The build context is the source only: everything generated is made on first start in the /data volume.
.git
.github
.venv/
venv/
**/__pycache__/
*.pyc
.pytest_cache/

# build outputs and local runs
/build/
/build*/
/dist/
/engine/
cmake-build-*/

# model files and runtime data never belong in the image
/data/cfg.json
/models/
/packs/
/mtp/
*.gguf
*.part
*.done
*.log

# secrets and local configuration
.env
.env.*
!.env.example

# tests and docs are not needed to run
**/test_*.py
**/*_test.py
/tests/
/docs/
*.md
!LICENSE
/scripts/
docker-compose.yml
Dockerfile
.dockerignore
