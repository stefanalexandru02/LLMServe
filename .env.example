# LLMServe settings.  Copy to .env (Windows: copy .env.example .env) and edit.  Every line is optional.
# After changing a value: docker compose up -d      (the model is not downloaded again; cfg.json is rewritten)
# Values with spaces or semicolons go in quotes.

# ---------------------------------------------------------------------------------------------------- the model
# Which quantization.  Download size / RAM it asks for / what it is:
#   Q2_0        66 GB /  48 GB   2-bit, the fastest (default)
#   IQ2_XS      68 GB /  48 GB   2-bit i-quant, slightly better quality
#   IQ3_XXS     76 GB /  60 GB   3-bit
#   IQ3_S       84 GB /  62 GB   3.5-bit, best quality of the small ones; wants a 64 GB machine with little else running
#   IQ1_M       58 GB /  32 GB   the Coder release: half the experts, code/tools/images kept (fits 32-40 GB of RAM)
#   UD-IQ4_XS   94 GB /  48 GB+  Unsloth 4-bit; ~80 GB of RAM keeps every expert, less reads part from the SSD
#   UD-Q4_K_XL 111 GB /  48 GB+  Unsloth 4-bit K-quant; ~94 GB of RAM keeps every expert (64 GB: ~8 tok/s from the SSD)
#   UD-Q5_K_XL, UD-Q6_K_XL, Q8_0   158-188 GB, 108-136 GB of RAM
LLMSERVE_QUANT=Q2_0

# Context window in tokens: 8192 ... 262144 (trained length); 65536, 128k, auto (chosen from your VRAM and RAM).
# Above 262144 the engine uses yarn rope scaling.  Bigger = more VRAM for the KV cache = fewer experts cached on the GPU.
LLMSERVE_CONTEXT=65536

# Requests answered at the same time (1-8).  1 is fastest per request; more helps several users on a big GPU.
LLMSERVE_PARALLEL=1

# Pictures: off | on | gpu | cpu.  "on" = reader on the GPU with 24 GB+ of VRAM, otherwise on the CPU.  Downloads 0.9 GB more.
# Needs the image built with WITH_VISION=1 (the default).
LLMSERVE_VISION=off

# ---------------------------------------------------------------------------------------------------- access
# The key clients must send ("Authorization: Bearer <key>" or "x-api-key").  Make one: openssl rand -hex 24
# Empty = no key, fine while the port stays on 127.0.0.1.
LLMSERVE_API_KEY=
# Or read it from a file inside the container (Docker secrets): LLMSERVE_API_KEY_FILE=/run/secrets/llmserve_key

# Where the port is published on the host.  127.0.0.1 = this computer only.  0.0.0.0 = your network: set an API key first.
LLMSERVE_BIND=127.0.0.1
LLMSERVE_HOST_PORT=8080

# A Hugging Face token, only if a download asks for a login (the default model files are public).
HF_TOKEN=

# ---------------------------------------------------------------------------------------------------- tuning (optional)
# KV cache format: int8 (default, what the published speeds use) | q4_0 (half the memory, a little less exact) | k8v4 | fp16
#LLMSERVE_KV=int8
# KV streaming (the KV cache in RAM, from 64K context): auto | on | off.  Always off on WSL2/Docker Desktop (the driver pins little there).
#LLMSERVE_KV_STREAMING=auto
# Draft layer (MTP, about 2x faster output; ~1 GB of VRAM and a 5 GB download): on | off
#LLMSERVE_MTP=on
# Draft vocabulary: cjk (default) | en (English and code, ~215 MiB less VRAM; use it on 12 GB cards) | cyrillic | fr
#LLMSERVE_DRAFT_VOCAB=en
# Not enough RAM for the quant: auto | off | on | resident | mmap  (low-RAM mode reads experts from the SSD)
#LLMSERVE_LOW_RAM=auto
# Unsloth quants: GiB of experts to keep in RAM (default: RAM minus 24)
#LLMSERVE_RESIDENT_BUDGET_GIB=
# VRAM in MiB to leave free for other programs, e.g. the Windows desktop (default 700)
#LLMSERVE_VRAM_RESERVE_MIB=1500
# Rope scaling past the trained 262144 tokens: yarn (default) | linear | none; the factor defaults to context / 262144
#LLMSERVE_ROPE_SCALING=yarn
#LLMSERVE_ROPE_SCALE=
# Most image tokens per picture (default 1024 on the GPU reader, 300 on the CPU reader; more = more detail, slower)
#LLMSERVE_VISION_TOKENS=
# Several GPUs: the one to use, as nvidia-smi numbers it
#LLMSERVE_GPU=0
# --- several requests at once (LLMSERVE_PARALLEL=2 or more).  Each slot reserves the full context of KV in VRAM, taking VRAM from the
# expert cache (an estimate: ~1.0 GB per slot at 64K on a 24 GB card, about 5% of the cache; the engine log prints the exact size).
# Draft proposals inside the batch (one per slot per window).  If the start log says "MTP admission ... failed", turn it off:
#LLMSERVE_BATCH_MTP=off
# The engine's opt-in batch-window switches: STRATA_BATCH_GDN_GROUPS=1 STRATA_BATCH_ATTN_ROWS=1 (not with KV streaming)
# STRATA_SLOT_COPY_DIRECT=1 STRATA_SLOT_COPY_BATCHSYNC=1.  Your LLMSERVE_ENGINE_ENV wins over them.
#LLMSERVE_BATCH_SWITCHES=off
# Coding-agent settings: STRATA_CACHE_MESSAGE_BOUNDARY=1 (prompt snapshot at the last message), with PARALLEL >= 2
# STRATA_ADMIT_SHORT_FIRST=4096 (a short sub-agent request is read before a 30K cold prompt), and --conversation-cache-mib 4096
# (RAM for parked conversations, less if RAM is short).  Your LLMSERVE_EXTRA_ARGS / LLMSERVE_ENGINE_ENV / the next line win.
#LLMSERVE_AGENT=off
# RAM in MiB for parked conversations (0 = off).  Default: the engine sizes it from the free RAM, or 4096 with LLMSERVE_AGENT=on.
#LLMSERVE_CONVERSATION_CACHE_MIB=
# Any engine argument, appended (and winning over generated ones): "--pool-workers 8 --spec 3"
#LLMSERVE_EXTRA_ARGS=
# Engine environment variables: "KEY=VALUE KEY2=VALUE2"
#LLMSERVE_ENGINE_ENV=
# Arguments for the HTTP server: "--api-monitor --max-queue 8"
#LLMSERVE_SERVER_ARGS=
# Seconds the server lets running requests finish on `docker compose stop` (0-300)
#LLMSERVE_SHUTDOWN_TIMEOUT=30

# ---------------------------------------------------------------------------------------------------- maintenance
# 1 for one start: run the prepare steps even if /data/cfg.json looks current (finished downloads are not repeated)
#LLMSERVE_REPREPARE=0
# 1 for one start: also redo the model pack and the draft layer (the 40 GB Q2_0 repack)
#LLMSERVE_FORCE=0
# 1: never run prepare, use /data/cfg.json as it is (you edited it by hand)
#LLMSERVE_SKIP_PREPARE=0
# 1: do not stop when no GPU / an old driver is detected
#LLMSERVE_SKIP_GPU_CHECK=0
# A Hugging Face mirror
#HF_ENDPOINT=

# ---------------------------------------------------------------------------------------------------- build (docker compose build)
# GPU architectures to compile for.  Build only for your card to save 15-20 minutes:
#   RTX 30xx: 86   RTX 40xx: 89   RTX 50xx: 120   (native code + PTX for forward compatibility)
#CUDA_ARCHS="89-real;89-virtual"
# ON: runs on any PC with AVX2.  OFF: -march=native for the PC that BUILDS the image (build and run on the same PC).
#PORTABLE=ON
# 1: also build the picture reader.  0: skip it (~10 minutes faster; LLMSERVE_VISION must stay off)
#WITH_VISION=1
# Compiler jobs.  Lower (4) if the build is killed for lack of memory (Docker Desktop's VM has half of your RAM by default).
#BUILD_JOBS=4
